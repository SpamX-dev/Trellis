{
  "name": "trellis-contracts",
  "private": true,
  "type": "module",
  "description": "Контракты и первый серверный контур Trellis",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node trellis-knowledge/validation/check.mjs",
    "test": "node --test trellis-knowledge/validation/check.test.mjs",
    "build:api": "tsc -p trellis-knowledge/tsconfig.json",
    "build:web": "tsc -p trellis-web/tsconfig.json && vite build --config trellis-web/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "start:api": "node dist/trellis-knowledge/server/main.js",
    "dev:web": "vite --config trellis-web/vite.config.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "8.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "antd": "^6.6.5",
    "jose": "^6.2.12",
    "oidc-client-ts": "^3.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
